# Any field can come from env vars: <PREFIX>__<SECTION>__<FIELD>[__<SUB>], upper case.
# The host chooses the prefix (ConfigSource::with_env("COUNTERPARTIES")).
COUNTERPARTIES__POOL__SCOPE=total
COUNTERPARTIES__POOL__MAX=32
COUNTERPARTIES__POOL__HOLD=15s
COUNTERPARTIES__CONNECTIONS__USERS__ENDPOINT=https://users.internal:9090
COUNTERPARTIES__CONNECTIONS__USERS__MAX=unlimited
COUNTERPARTIES__CONNECTIONS__USERS__AUTH__MODE=mixed
COUNTERPARTIES__CONNECTIONS__USERS__AUTH__ENVVAR=COUNTERPARTIES_USERS_SECRET

# Secrets are only ever read from the env var named in `auth.envvar`, never from YAML.
COUNTERPARTIES_USERS_SECRET=change-me
